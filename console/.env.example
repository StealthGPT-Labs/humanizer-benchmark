# Import through Vercel Project Settings > Environment Variables.
# Select Production and store API credentials as Secret values.
# Do not import BENCHMARK_OWNER_PASSWORD: it is provisioned separately.
# Keep every value private. Never use a NEXT_PUBLIC_ prefix for a credential.

# Humanizers
STEALTHGPT_API_KEY=
PHRASLY_API_KEY=
REPHRASY_API_KEY=
UNDETECTABLE_API_KEY=
HIX_API_KEY=
HUMBOT_API_KEY=
BYPASSGPT_API_KEY=
WRITEHUMAN_API_KEY=
GRUBBY_API_KEY=
REWRITEAI_API_KEY=

# Detectors; both Originality models use the same credential.
PANGRAM_API_KEY=
GPTZERO_API_KEY=
ORIGINALITY_API_KEY=
ZEROGPT_API_KEY=
WINSTON_API_KEY=

# Production quality judges use OpenRouter. Syntax integrity is deterministic.
OPENROUTER_API_KEY=
